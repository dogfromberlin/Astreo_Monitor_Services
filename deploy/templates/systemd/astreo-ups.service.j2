[Unit]
Description=Astreo Monitor - controllo degli UPS
Documentation=file://{{ project_dir }}/docs/it/ups.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User={{ user }}
Group={{ group }}
WorkingDirectory={{ project_dir }}
Environment=ASTREO_MONITOR_CONFIG={{ config_dir }}/config.ini
Environment=PYTHONUNBUFFERED=1
ExecStart={{ project_dir }}/.venv/bin/python -m astreo_monitor.jobs.ups
TimeoutStartSec=50
NoNewPrivileges=true
# legge gli UPS in rete (NUT, apcupsd, SNMP): nessun permesso particolare
