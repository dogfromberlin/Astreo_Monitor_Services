[Unit]
Description=Astreo Monitor - pulizia dati (retention)
Documentation=file://{{ project_dir }}/docs/database.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User={{ user }}
Group={{ group }}
WorkingDirectory={{ project_dir }}
Environment=ASTREO_MONITOR_CONFIG={{ config_dir }}/config.ini
Environment=PYTHONUNBUFFERED=1
ExecStart={{ project_dir }}/.venv/bin/python -m astreo_monitor.jobs.maintenance
TimeoutStartSec=1800
NoNewPrivileges=true
