[Unit]
Description=Astreo Monitor - dashboard e API
Documentation=file://{{ project_dir }}/docs/it/dashboard.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ user }}
Group={{ group }}
WorkingDirectory={{ project_dir }}
Environment=ASTREO_MONITOR_CONFIG={{ config_dir }}/config.ini
Environment=PYTHONUNBUFFERED=1
ExecStart={{ project_dir }}/.venv/bin/python -m astreo_monitor.web
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
