[Unit]
Description=Astreo Monitor - bot Telegram (comandi /stato, /speedtest, ...)
Documentation=file://{{ project_dir }}/docs/it/notifications.md
After=network-online.target mssql-server.service
Wants=network-online.target

[Service]
Type=simple
User={{ user }}
Group={{ group }}
WorkingDirectory={{ project_dir }}
Environment=ASTREO_MONITOR_CONFIG={{ config_dir }}/config.ini
Environment=PYTHONUNBUFFERED=1
ExecStart={{ project_dir }}/.venv/bin/python -m astreo_monitor.telegram_bot
Restart=always
RestartSec=10
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
