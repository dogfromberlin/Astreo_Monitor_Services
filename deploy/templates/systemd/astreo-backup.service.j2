[Unit]
Description=Astreo Monitor - backup database con copia su GitHub
Documentation=file://{{ project_dir }}/docs/it/backup.md
After=network-online.target mssql-server.service
Wants=network-online.target

[Service]
Type=oneshot
User={{ user }}
Group={{ group }}
WorkingDirectory={{ project_dir }}
Environment=ASTREO_MONITOR_CONFIG={{ config_dir }}/config.ini
Environment=PYTHONUNBUFFERED=1
# gh legge le credenziali da ~/.config/gh
Environment=HOME={{ home }}
ExecStart={{ project_dir }}/.venv/bin/python -m astreo_monitor.jobs.db_backup
TimeoutStartSec=3600
NoNewPrivileges=true
